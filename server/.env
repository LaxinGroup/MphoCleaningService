# ============================================================
# MUPHO THE CLEANER — Server Environment Variables
# ============================================================
# This file is for LOCAL DEVELOPMENT only.
# It is listed in .gitignore and will never be committed.
# For production, paste these values into your Render dashboard.
# ============================================================


# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000


# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Add your Vercel URL here once deployed.
CLIENT_ORIGIN=http://localhost:3000


# ── Neon PostgreSQL ─────────────────────────────────────────
DATABASE_URL=postgresql://neondb_owner:npg_7FwQVHkrjsN2@ep-dark-tooth-bd597fhu-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require


